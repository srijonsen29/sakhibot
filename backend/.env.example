GROQ_API_KEY=your_groq_api_key_here

# ── Dev-only auth bypass ─────────────────────────────────────────────────
# true  = skips login entirely. Anyone opening the app is automatically
#         logged in as the first user row in the database — no password,
#         no token needed. Requires at least one user to already exist.
# false = normal behavior. Login/signup work as usual and are required.
# Must match VITE_BYPASS_AUTH in the frontend .env to actually take effect.
# NEVER set true in production or commit as true.
BYPASS_AUTH=true

# ── JWT auth ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── CORS — comma-separated list of allowed frontend origins ────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ── Database — relative path avoids Windows backslash/space issues ─────────
DATABASE_URL=sqlite:///./sakhibot.db

# ── Skip network checks for locally-cached HF embedding model ──────────────
# 1 = never contact huggingface.co at startup, use only the local cache
#     (fast startup, but fails if the model was never downloaded before).
# 0, or unset = check huggingface.co for updates on every startup
#     (slower, and hangs/retries if that site is unreachable).
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1