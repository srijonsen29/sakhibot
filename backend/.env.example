# ============================
# SakhiBot Environment Configuration
# ============================

# Enter your Groq API key.
GROQ_API_KEY=your_groq_api_key

# Set to true only for development/testing.
BYPASS_AUTH=true

# JWT Configuration
JWT_SECRET_KEY=change-this-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Frontend URLs allowed to access the backend.
# Modify only if your frontend runs on a different port or domain.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://sakhibot.vercel.app

# SQLite database location.
# Replace 'path_to_your_project' with the location where you cloned the project.
#
# Examples:
# DATABASE_URL=sqlite:///E:/sakhibot/backend/sakhibot.db
# DATABASE_URL=sqlite:///C:/Projects/sakhibot/backend/sakhibot.db
DATABASE_URL=sqlite:///path_to_your_project/backend/sakhibot.db
